# Copy to .env to override defaults. Docker Compose loads .env automatically.
# Only needed on networks where registry.npmjs.org is not reachable directly.
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# Linux only: set these to `id -u` and `id -g` when the host account is not 1000:1000.
# Docker Desktop users can keep the defaults.
LOCAL_UID=1000
LOCAL_GID=1000
